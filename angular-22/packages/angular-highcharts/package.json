{
  "name": "@stackline/angular-highcharts",
  "version": "22.0.0",
  "description": "Angular 22 wrapper components for Highcharts, Highstock, Highmaps, zAxis, and colorAxis integrations",
  "main": "fesm2022/stackline-angular-highcharts.mjs",
  "module": "fesm2022/stackline-angular-highcharts.mjs",
  "es2015": "fesm2022/stackline-angular-highcharts.mjs",
  "typings": "types/stackline-angular-highcharts.d.ts",
  "types": "types/stackline-angular-highcharts.d.ts",
  "files": [
    "bundles",
    "esm2015",
    "esm2020",
    "esm2022",
    "fesm2015",
    "fesm2020",
    "fesm2022",
    "types",
    "*.d.ts",
    "*.metadata.json",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandroit/angular-highcharts.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "angular",
    "angular22",
    "angular-library",
    "typescript",
    "charts",
    "highcharts",
    "highcharts-angular",
    "chart-wrapper",
    "highstock",
    "highmaps",
    "coloraxis",
    "zaxis",
    "accessibility-focused",
    "aria-tested",
    "keyboard-tested",
    "a11y",
    "maintained",
    "stackline"
  ],
  "author": "Alexandro Paixao Marques",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/alexandroit/angular-highcharts/issues"
  },
  "homepage": "https://alexandro.net/docs/angular/angular-highcharts/",
  "peerDependencies": {
    "@angular/core": ">=22.0.0 <24.0.0",
    "highcharts": ">=5.0.0 <=12.6.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./types/stackline-angular-highcharts.d.ts",
      "default": "./fesm2022/stackline-angular-highcharts.mjs"
    }
  },
  "type": "module"
}

{
  "name": "stackline-angular-highcharts-angular-22",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/start.mjs",
    "dev": "ng serve --host 0.0.0.0 --port 4432",
    "serve:static": "node scripts/static-server.mjs",
    "test:server": "node --test scripts/static-server.test.mjs",
    "build": "ng build --configuration development --base-href ./",
    "build:static": "ng build --configuration production --base-href ./ --output-hashing=none",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "22.1.4",
    "@angular/compiler": "22.1.4",
    "@angular/core": "22.1.4",
    "@angular/forms": "22.1.4",
    "@angular/platform-browser": "22.1.4",
    "@angular/router": "22.1.4",
    "@stackline/angular-highcharts": "file:packages/angular-highcharts",
    "highcharts": "12.6.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.6",
    "@angular/cli": "22.1.6",
    "@angular/compiler-cli": "22.1.4",
    "prettier": "^3.8.1",
    "typescript": "6.0.3"
  }
}
